---
import { architectureLifecycle } from '../data/profile';
---

<section class="section-band" aria-labelledby="lifecycle-heading">
  <div class="site-shell">
    <div class="section-header">
      <p class="eyebrow">Architecture lifecycle</p>
      <h2 id="lifecycle-heading" class="mt-3 text-3xl sm:text-4xl">
        From strategy to technology execution
      </h2>
      <p class="mt-4 max-w-2xl text-muted">
        A concise view of how architectural work moves from intent to governed delivery.
      </p>
    </div>

    <ol class="lifecycle-flow mt-12" aria-label="Architecture lifecycle">
      {
        architectureLifecycle.map((stage, index) => (
          <li class="lifecycle-flow__item">
            <span class="lifecycle-flow__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="lifecycle-flow__label">{stage}</span>
            {index < architectureLifecycle.length - 1 && (
              <span class="lifecycle-flow__connector" aria-hidden="true">
                →
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
