---
/**
 * Personal EA approach — semantic HTML diagram + supporting explanation.
 * EA is the enclosing discipline; BIDAT domains sit inside it.
 * Business Architecture establishes business direction within EA.
 *
 * homepage: focused, high-scan lifecycle model
 * full: richer Practice variant with Q&A, outputs, frameworks
 */
import { eaApproach } from '../data/ea-approach';

interface Props {
  /** homepage: diagram + brief supports; full: adds Q&A, outputs, frameworks */
  variant?: 'homepage' | 'full';
  id?: string;
}

const { variant = 'homepage', id = 'ea-approach' } = Astro.props;
const isFull = variant === 'full';
const headingId = `${id}-heading`;
const diagramId = `${id}-diagram`;
---

<section
  class:list={[
    'ea-approach',
    'section-band',
    isFull ? 'ea-approach--full' : 'ea-approach--homepage',
  ]}
  aria-labelledby={headingId}
  data-reveal
  id={id}
>
  <div class="site-shell">
    <div class="section-header">
      <p class="eyebrow">Approach</p>
      <h2 id={headingId} class="mt-3 text-3xl sm:text-4xl">{eaApproach.title}</h2>
      <p class="mt-4 max-w-2xl font-serif text-xl text-ink sm:text-2xl">
        {eaApproach.subtitle}
      </p>
      {
        isFull && (
          <p class="mt-5 max-w-2xl text-muted">{eaApproach.plainLanguage}</p>
        )
      }
      <p class="ea-principle mt-4 max-w-2xl text-sm font-medium text-ink sm:text-base">
        {eaApproach.principle}
      </p>
    </div>

    <figure
      class:list={['ea-framework', 'mt-12', !isFull && 'ea-framework--homepage']}
      aria-labelledby={diagramId}
    >
      <figcaption id={diagramId} class="sr-only">
        Diagram of a personal enterprise architecture approach. Strategy sits above an Enterprise
        Architecture boundary. Inside that boundary, Business Architecture provides the business
        foundation and establishes business direction that informs Information, Data, Application
        and Technology architectures. People, process and technology alignment cut across those
        domains. Governance, principles, security and risk span the model. Below the boundary:
        Target Architecture, Transition Architecture and Roadmap, then Delivery, then Outcomes
        with feedback to strategy and architecture. Domains iterate; the model is not a one-way
        waterfall. BIDAT is used here as a clear domain framing for this approach — not as a claim
        that every EA standard uses identical domain labels.
      </figcaption>

      <div
        class="ea-framework__canvas"
        role="group"
        aria-label="Enterprise architecture approach model"
      >
        {/* STRATEGY */}
        <article
          class="ea-layer ea-band ea-band--intent"
          tabindex="0"
          data-ea-layer="strategy"
          aria-label={`${eaApproach.businessIntent.label}: ${eaApproach.businessIntent.definition}`}
        >
          <p class="ea-band__label">
            <span class="ea-band__role">Above EA</span>
            <span aria-hidden="true"> · </span>
            {eaApproach.businessIntent.label}
          </p>
          <p class="ea-layer__title">{eaApproach.businessIntent.detail}</p>
          <p class="ea-layer__def">{eaApproach.businessIntent.definition}</p>
          {
            isFull && (
              <ul class="ea-chip-row">
                {eaApproach.businessIntent.items.map((item) => (
                  <li class="ea-chip">{item}</li>
                ))}
              </ul>
            )
          }
        </article>

        <div class="ea-connector" aria-hidden="true">
          <span class="ea-connector__line" />
          <span class="ea-connector__arrow">↓</span>
        </div>

        {/* EA BOUNDARY — contains BIDAT */}
        <div
          class="ea-boundary"
          role="group"
          aria-label={eaApproach.eaBoundary.label}
        >
          <div class="ea-boundary__header">
            <p class="ea-boundary__title">{eaApproach.eaBoundary.label}</p>
            <p class="ea-boundary__role">{eaApproach.eaBoundary.role}</p>
          </div>

          {/* Business Architecture — emphasised; not an identical IDAT box */}
          <article
            class="ea-layer ea-band ea-band--foundation"
            tabindex="0"
            data-ea-layer="business-architecture"
            aria-label={`${eaApproach.businessArchitecture.label}: ${eaApproach.businessArchitecture.definition}`}
          >
            <p class="ea-band__label">
              <span class="ea-band__role">Foundation</span>
              <span aria-hidden="true"> · </span>
              {eaApproach.businessArchitecture.label}
            </p>
            <p class="ea-layer__title ea-layer__title--foundation">
              {eaApproach.businessArchitecture.summary}
            </p>
            <p class="ea-layer__def">{eaApproach.businessArchitecture.definition}</p>
            {
              isFull && (
                <ul class="ea-chip-row">
                  {eaApproach.businessArchitecture.items.map((item) => (
                    <li class="ea-chip ea-chip--emphasis">{item}</li>
                  ))}
                </ul>
              )
            }
          </article>

          <div class="ea-connector ea-connector--direction" aria-hidden="true">
            <span class="ea-connector__line" />
            <span class="ea-connector__arrow">↓</span>
            <span class="ea-connector__caption">
              {eaApproach.businessArchitecture.directionNote}
            </span>
          </div>

          {/* IDAT — remaining BIDAT domains */}
          <div
            class="ea-band ea-band--bidat"
            role="group"
            aria-label={`BIDAT domains: ${eaApproach.idatLabel}`}
          >
            <p class="ea-band__label">
              <span class="ea-band__role">BIDAT domains</span>
              <span aria-hidden="true"> · </span>
              {eaApproach.idatLabel}
            </p>
            <ul class="ea-bidat">
              {
                eaApproach.bidatDomains.map((domain, index) => (
                  <li
                    class="ea-layer ea-bidat__domain"
                    tabindex="0"
                    data-domain={domain.id}
                    data-ea-layer={domain.id}
                    aria-label={`${domain.short}: ${domain.definition}`}
                  >
                    <h3 class="ea-bidat__title">{isFull ? domain.title : domain.short}</h3>
                    <p class="ea-bidat__text">{domain.definition}</p>
                    {
                      isFull && (
                        <p class="ea-bidat__text ea-bidat__text--secondary">{domain.description}</p>
                      )
                    }
                    {index < eaApproach.bidatDomains.length - 1 && (
                      <span class="ea-bidat__join" aria-hidden="true">
                        ↔
                      </span>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>

          {/* Cross-domain alignment — subtle People · Process · Technology */}
          <article
            class="ea-layer ea-band ea-band--dimensions"
            tabindex="0"
            data-ea-layer="cross-domain"
            aria-label={`${eaApproach.crossDomain.label}: ${eaApproach.crossDomain.definition}`}
          >
            <p class="ea-band__label">
              <span class="ea-band__role">{eaApproach.crossDomain.role}</span>
              <span aria-hidden="true"> · </span>
              {eaApproach.crossDomain.label}
            </p>
            <p class="ea-layer__def">{eaApproach.crossDomain.definition}</p>
            {
              isFull ? (
                <>
                  <p class="ea-cross-note">{eaApproach.crossDomain.note}</p>
                  <ul class="ea-dimensions">
                    {eaApproach.crossDomain.items.map((dim) => (
                      <li class="ea-dimension" data-dimension={dim.id}>
                        <h3 class="ea-dimension__title">{dim.title}</h3>
                        <p class="ea-dimension__text">{dim.description}</p>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <ul class="ea-cross-compact" aria-label="People, process and technology">
                  {eaApproach.crossDomain.items.map((dim) => (
                    <li class="ea-cross-compact__item">
                      <span class="ea-cross-compact__title">{dim.title}</span>
                      <span class="ea-cross-compact__text">{dim.description}</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </article>

          <aside class="ea-spanning" aria-label={eaApproach.spanning.label}>
            <p class="ea-spanning__label">{eaApproach.spanning.label}</p>
            <ul class="ea-spanning__list">
              {eaApproach.spanning.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </aside>
        </div>

        <div class="ea-connector" aria-hidden="true">
          <span class="ea-connector__line" />
          <span class="ea-connector__arrow">↓</span>
        </div>

        {/* Target → Transition → Delivery */}
        <ol class="ea-journey" aria-label="From target architecture to delivery">
          {
            eaApproach.changeStages.map((stage, index) => (
              <li class="ea-journey__item">
                <article
                  class="ea-layer ea-band ea-band--stage"
                  tabindex="0"
                  data-ea-layer={stage.id}
                  aria-label={`${stage.label}: ${stage.definition}`}
                >
                  <p class="ea-band__label">
                    <span class="ea-band__role">{stage.role}</span>
                    <span aria-hidden="true"> · </span>
                    {stage.label}
                  </p>
                  <p class="ea-layer__def">{stage.definition}</p>
                </article>
                {
                  index < eaApproach.changeStages.length - 1 && (
                    <div class="ea-connector" aria-hidden="true">
                      <span class="ea-connector__line" />
                      <span class="ea-connector__arrow">↓</span>
                    </div>
                  )
                }
              </li>
            ))
          }
        </ol>

        <div class="ea-connector" aria-hidden="true">
          <span class="ea-connector__line" />
          <span class="ea-connector__arrow">↓</span>
        </div>

        {/* OUTCOMES + feedback */}
        <article
          class="ea-layer ea-band ea-band--outcomes"
          tabindex="0"
          data-ea-layer="outcomes"
          aria-label={`${eaApproach.outcomes.label}: ${eaApproach.outcomes.definition}`}
        >
          <p class="ea-band__label">
            <span class="ea-band__role">Results</span>
            <span aria-hidden="true"> · </span>
            {eaApproach.outcomes.label}
          </p>
          <p class="ea-layer__def">{eaApproach.outcomes.definition}</p>
          <p class="ea-outcomes__framing">{eaApproach.outcomes.framing}</p>
          {
            isFull && (
              <ul class="ea-chip-row">
                {eaApproach.outcomes.items.map((item) => (
                  <li class="ea-chip">{item}</li>
                ))}
              </ul>
            )
          }
        </article>

        <p class="ea-feedback" role="note">
          <span class="ea-feedback__marker" aria-hidden="true">↻</span>
          <span>
            <span class="ea-feedback__cue">{eaApproach.outcomes.feedbackCue}.</span>{' '}
            {eaApproach.outcomes.feedback}
          </span>
        </p>
      </div>
    </figure>

    <details class="ea-text-equivalent mt-8">
      <summary>Text equivalent of the approach model</summary>
      <div class="ea-text-equivalent__body">
        <p>
          <strong>Strategy:</strong> {eaApproach.businessIntent.detail}.{' '}
          {eaApproach.businessIntent.definition}
        </p>
        <p>
          <strong>Enterprise Architecture</strong> is the overarching discipline containing the
          BIDAT domains.
        </p>
        <p>
          <strong>Business Architecture</strong> ({eaApproach.businessArchitecture.role}):{' '}
          {eaApproach.businessArchitecture.summary}.{' '}
          {eaApproach.businessArchitecture.explanation}
        </p>
        <p>
          <strong>Connected BIDAT domains ({eaApproach.idatLabel}):</strong>
        </p>
        <ul>
          {
            eaApproach.bidatDomains.map((domain) => (
              <li>
                <strong>{domain.title}:</strong> {domain.definition} {domain.description}
              </li>
            ))
          }
        </ul>
        <p>
          <strong>{eaApproach.crossDomain.label}:</strong> {eaApproach.crossDomain.definition}{' '}
          {eaApproach.crossDomain.note}
        </p>
        <ul>
          {
            eaApproach.crossDomain.items.map((dim) => (
              <li>
                <strong>{dim.title}:</strong> {dim.description}
              </li>
            ))
          }
        </ul>
        <p>
          <strong>{eaApproach.spanning.label}:</strong>{' '}
          {eaApproach.spanning.items.join('; ')}.
        </p>
        <p>
          <strong>Change journey:</strong>{' '}
          {eaApproach.changeStages.map((stage) => stage.label).join(' → ')}.
        </p>
        <ul>
          {
            eaApproach.changeStages.map((stage) => (
              <li>
                <strong>{stage.label}:</strong> {stage.definition}
              </li>
            ))
          }
        </ul>
        <p>
          <strong>Outcomes:</strong> {eaApproach.outcomes.definition}{' '}
          {eaApproach.outcomes.feedbackCue}. {eaApproach.outcomes.feedback}
        </p>
        <p>
          <strong>Framing note:</strong> {eaApproach.synthesisNote}
        </p>
      </div>
    </details>

    {
      !isFull && (
        <p class="ea-foundation-note mt-8 max-w-2xl text-muted">
          {eaApproach.businessArchitecture.explanation}
        </p>
      )
    }

    {
      isFull && (
        <>
          <div class="ea-supports mt-14">
            <h3 class="text-2xl">How the model answers executive questions</h3>
            <dl class="ea-supports__list mt-6">
              {
                eaApproach.supportsDecisions.map((item) => (
                  <div class="ea-supports__item">
                    <dt>{item.question}</dt>
                    <dd>{item.answer}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <div class="ea-outputs mt-14" aria-labelledby={`${id}-outputs`}>
            <h3 id={`${id}-outputs`} class="text-2xl">
              {eaApproach.typicalOutputs.title}
            </h3>
            <p class="mt-3 max-w-2xl text-sm text-muted">
              {eaApproach.typicalOutputs.framing}
            </p>
            <ul class="ea-outputs__list mt-5">
              {eaApproach.typicalOutputs.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <aside class="ea-frameworks mt-14" aria-labelledby={`${id}-frameworks`}>
            <h3 id={`${id}-frameworks`} class="text-xl">
              Conceptual references
            </h3>
            <p class="mt-3 text-sm text-muted">{eaApproach.synthesisNote}</p>
            <ul class="ea-frameworks__list mt-4">
              <li>
                <a href={eaApproach.frameworks.togaf.href} rel="noopener noreferrer">
                  {eaApproach.frameworks.togaf.label}
                </a>
                <span class="text-muted"> — {eaApproach.frameworks.togaf.summary}</span>
              </li>
              <li>
                <a href={eaApproach.frameworks.zachman.href} rel="noopener noreferrer">
                  {eaApproach.frameworks.zachman.label}
                </a>
                <span class="text-muted"> — {eaApproach.frameworks.zachman.summary}</span>
              </li>
              <li>
                <a href={eaApproach.frameworks.bidat.href} rel="noopener noreferrer">
                  {eaApproach.frameworks.bidat.label}
                </a>
                <span class="text-muted"> — {eaApproach.frameworks.bidat.summary}</span>
              </li>
            </ul>
          </aside>
        </>
      )
    }

    {
      !isFull && (
        <p class="ea-synthesis mt-8 text-sm text-muted">
          {eaApproach.synthesisNote}{' '}
          <a href={`#${id}-frameworks-home`} class="ea-synthesis__link">
            Framework references
          </a>
        </p>
      )
    }

    {
      !isFull && (
        <aside class="ea-frameworks ea-frameworks--compact mt-4" id={`${id}-frameworks-home`}>
          <ul class="ea-frameworks__list">
            <li>
              <a href={eaApproach.frameworks.togaf.href} rel="noopener noreferrer">
                {eaApproach.frameworks.togaf.label}
              </a>
              <span class="text-muted"> — architecture development and governance</span>
            </li>
            <li>
              <a href={eaApproach.frameworks.zachman.href} rel="noopener noreferrer">
                {eaApproach.frameworks.zachman.label}
              </a>
              <span class="text-muted">
                {' '}
                — complementary perspectives (Why, What, How, Who, Where, When)
              </span>
            </li>
            <li>
              <a href={eaApproach.frameworks.bidat.href} rel="noopener noreferrer">
                BIDAT
              </a>
              <span class="text-muted">
                {' '}
                — Business, Information, Data, Application and Technology architectures within EA
              </span>
            </li>
          </ul>
        </aside>
      )
    }
  </div>
</section>
