---
/**
 * Concise architecture principles + practice boundaries.
 * Presentation-only; copy sourced from architecture-beliefs data.
 */
import { architectureBeliefs } from '../data/architecture-beliefs';

interface Props {
  id?: string;
}

const { id = 'architecture-beliefs' } = Astro.props;
const headingId = `${id}-heading`;
const boundariesId = `${id}-boundaries`;
---

<section
  class="architecture-beliefs section-space"
  aria-labelledby={headingId}
  id={id}
  data-reveal
>
  <div class="site-shell">
    <div class="section-header max-w-3xl">
      <p class="eyebrow">Practice beliefs</p>
      <h2 id={headingId} class="mt-3 text-3xl sm:text-4xl">
        {architectureBeliefs.title}
      </h2>
      <p class="mt-4 max-w-2xl text-muted">{architectureBeliefs.intro}</p>
    </div>

    <ol class="beliefs-principles mt-10" aria-labelledby={headingId}>
      {
        architectureBeliefs.principles.map((principle, index) => (
          <li class="beliefs-principles__item" id={principle.id}>
            <p class="beliefs-principles__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </p>
            <div class="beliefs-principles__body">
              <h3 class="beliefs-principles__title">{principle.title}</h3>
              <p class="beliefs-principles__text">{principle.statement}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="beliefs-boundaries mt-14" aria-labelledby={boundariesId}>
      <h3 id={boundariesId} class="text-2xl sm:text-3xl">
        {architectureBeliefs.boundaries.title}
      </h3>
      <p class="mt-4 max-w-2xl text-muted">{architectureBeliefs.boundaries.intro}</p>
      <ul class="beliefs-boundaries__list mt-6">
        {
          architectureBeliefs.boundaries.items.map((item) => (
            <li class="beliefs-boundaries__item">{item}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
