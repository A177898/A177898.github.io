---
/**
 * Scroll reading progress for long-form Perspective / RA pages.
 * Zero visual impact when prefers-reduced-motion; content readable without JS.
 */
---

<div
  class="reading-progress no-print"
  data-reading-progress
  role="progressbar"
  aria-label="Reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  hidden
>
  <div class="reading-progress__bar" data-reading-progress-bar></div>
</div>

<script>
  function bindReadingProgress() {
    const root = document.querySelector('[data-reading-progress]');
    const bar = document.querySelector('[data-reading-progress-bar]');
    const article = document.querySelector('article');
    if (!(root instanceof HTMLElement) || !(bar instanceof HTMLElement) || !article) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.hidden = false;

    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = article.offsetHeight - window.innerHeight;
      const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
      const pct = total > 0 ? Math.round((scrolled / total) * 100) : 0;
      if (!reduceMotion) {
        bar.style.transform = `scaleX(${pct / 100})`;
      } else {
        bar.style.transform = `scaleX(${pct / 100})`;
        bar.style.transition = 'none';
      }
      root.setAttribute('aria-valuenow', String(pct));
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  bindReadingProgress();
  document.addEventListener('astro:page-load', bindReadingProgress);
</script>
