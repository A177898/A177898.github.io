---
interface Props {
  title: string;
  subtitle?: string;
  description: string;
  href: string;
  category?: string;
  tags?: string[];
  pubDateLabel?: string;
  draft?: boolean;
}

const {
  title,
  subtitle,
  description,
  href,
  category,
  tags = [],
  pubDateLabel,
  draft = false,
} = Astro.props;

const tagLine = tags.length > 0 ? tags.slice(0, 2).join(' · ') : undefined;
---

<article class="card-quiet">
  <div class="flex flex-wrap items-center gap-3">
    {category && <p class="eyebrow">{category}</p>}
    {
      draft && (
        <span class="perspective-draft-badge" role="status">
          Draft
        </span>
      )
    }
  </div>
  <h3 class="mt-2 text-xl">
    <a href={href} class="text-ink no-underline hover:underline">{title}</a>
  </h3>
  {subtitle && <p class="mt-2 font-serif text-base italic text-muted">{subtitle}</p>}
  <p class="mt-3 text-sm text-muted">{description}</p>
  {
    (tagLine || pubDateLabel) && (
      <p class="mt-4 text-xs text-muted">
        {tagLine}
        {tagLine && pubDateLabel ? ' · ' : ''}
        {pubDateLabel}
      </p>
    )
  }
</article>
