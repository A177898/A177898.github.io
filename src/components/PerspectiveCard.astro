---
interface Props {
  title: string;
  subtitle?: string;
  description: string;
  href: string;
  category?: string;
  tags?: string[];
  pubDateLabel?: string;
  draft?: boolean;
  /** Zero-padded editorial number, e.g. "01". */
  number?: string;
}

const {
  title,
  subtitle,
  description,
  href,
  category,
  tags = [],
  pubDateLabel,
  draft = false,
  number,
} = Astro.props;

const domainLine = tags.length > 0 ? tags.slice(0, 2).join(' · ') : undefined;
---

<article class="editorial-entry">
  <a class="editorial-entry__link" href={href}>
    <div class="editorial-entry__meta">
      {number && <span class="editorial-entry__number">{number}</span>}
      {category && <span class="eyebrow">{category}</span>}
      {
        draft && (
          <span class="perspective-draft-badge" role="status">
            Draft
          </span>
        )
      }
    </div>
    <h3 class="editorial-entry__title">{title}</h3>
    {subtitle && <p class="editorial-entry__subtitle">{subtitle}</p>}
    <p class="editorial-entry__summary">{description}</p>
    {
      (domainLine || pubDateLabel) && (
        <p class="editorial-entry__domain">
          {domainLine}
          {domainLine && pubDateLabel ? ' · ' : ''}
          {pubDateLabel}
        </p>
      )
    }
  </a>
</article>
