---
/**
 * Operating boundaries: Guardrails vs Gatekeeping + Authority vs Delivery ownership.
 * Explanatory comparison — not a restatement of TASK-05 principles or TASK-08 sequences.
 */
import { architectureOperatingBoundaries as content } from '../data/architecture-operating-boundaries';

const headingId = `${content.id}-heading`;
const guardrailsId = `${content.id}-guardrails`;
const authorityId = `${content.id}-authority`;
const gg = content.guardrailsVsGatekeeping;
const ao = content.authorityVsOwnership;
---

<section
  class="operating-boundaries section-space"
  id={content.id}
  aria-labelledby={headingId}
  data-reveal
>
  <div class="site-shell">
    <div class="section-header max-w-3xl">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 id={headingId} class="mt-3 text-3xl sm:text-4xl">{content.title}</h2>
      <p class="mt-4 max-w-2xl text-muted">{content.intro}</p>
    </div>

    <div class="operating-boundaries__block mt-12" aria-labelledby={guardrailsId}>
      <h3 id={guardrailsId} class="text-2xl sm:text-3xl">{gg.title}</h3>
      <p class="mt-4 max-w-2xl text-muted">{gg.intro}</p>

      <div class="operating-boundaries__compare mt-8">
        <article class="operating-boundaries__panel">
          <h4 class="operating-boundaries__panel-title">{gg.guardrails.title}</h4>
          <p class="operating-boundaries__panel-lead">{gg.guardrails.lead}</p>
          <ul class="operating-boundaries__list">
            {gg.guardrails.items.map((item) => <li>{item}</li>)}
          </ul>
          <p class="operating-boundaries__panel-outcome">{gg.guardrails.outcome}</p>
        </article>

        <article class="operating-boundaries__panel">
          <h4 class="operating-boundaries__panel-title">{gg.gatekeeping.title}</h4>
          <p class="operating-boundaries__panel-lead">{gg.gatekeeping.lead}</p>
          <ul class="operating-boundaries__list">
            {gg.gatekeeping.items.map((item) => <li>{item}</li>)}
          </ul>
          <p class="operating-boundaries__panel-outcome">{gg.gatekeeping.outcome}</p>
        </article>
      </div>

      <aside class="operating-boundaries__nuance mt-8" aria-labelledby={`${content.id}-formal`}>
        <h4 id={`${content.id}-formal`} class="operating-boundaries__nuance-title">
          {gg.formalGovernance.title}
        </h4>
        <p class="operating-boundaries__nuance-intro">{gg.formalGovernance.intro}</p>
        <ul class="operating-boundaries__list operating-boundaries__list--compact">
          {gg.formalGovernance.items.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>

    <div class="operating-boundaries__block mt-14" aria-labelledby={authorityId}>
      <h3 id={authorityId} class="text-2xl sm:text-3xl">{ao.title}</h3>
      <p class="mt-4 max-w-2xl text-muted">{ao.intro}</p>

      <div class="operating-boundaries__responsibility mt-8">
        <article class="operating-boundaries__panel">
          <h4 class="operating-boundaries__panel-title">{ao.architecture.title}</h4>
          <p class="operating-boundaries__panel-lead">{ao.architecture.lead}</p>
          <ul class="operating-boundaries__list">
            {ao.architecture.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>

        <article class="operating-boundaries__panel operating-boundaries__panel--shared">
          <h4 class="operating-boundaries__panel-title">{ao.shared.title}</h4>
          <p class="operating-boundaries__panel-lead">{ao.shared.lead}</p>
          <ul class="operating-boundaries__list">
            {ao.shared.items.map((item) => <li>{item}</li>)}
          </ul>
          <p class="operating-boundaries__panel-outcome">{ao.shared.note}</p>
        </article>

        <article class="operating-boundaries__panel">
          <h4 class="operating-boundaries__panel-title">{ao.delivery.title}</h4>
          <p class="operating-boundaries__panel-lead">{ao.delivery.lead}</p>
          <ul class="operating-boundaries__list">
            {ao.delivery.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>

    <p class="operating-boundaries__closing mt-12 max-w-2xl">{content.closing}</p>
  </div>
</section>
