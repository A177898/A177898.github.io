---
import { profile } from '../data/profile';

interface Props {
  /** Visual weight: about page pair vs compact experience cue. */
  variant?: 'pair' | 'rail';
}

const { variant = 'pair' } = Astro.props;
const roleArc = profile.careerArc;
const scopeArc = profile.scopeArc;
---

{
  variant === 'rail' ? (
    <div class="career-rail" aria-label="Architectural scope progression">
      <p class="career-rail__eyebrow">Scope progression</p>
      <ol class="career-rail__list">
        {scopeArc.map((stage, index) => (
          <li class="career-rail__item" style={`--rail-i: ${index}`}>
            <span class="career-rail__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="career-rail__label">{stage}</span>
            {index < scopeArc.length - 1 && (
              <span class="career-rail__connector" aria-hidden="true">
                →
              </span>
            )}
          </li>
        ))}
      </ol>
      <p class="career-rail__note">
        Expanding architectural horizon across the career — not a skills score.
      </p>
    </div>
  ) : (
    <div
      class="progression-pair"
      data-reveal
      aria-label="Role progression and expanding architectural scope"
    >
      <div>
        <p class="eyebrow" id="role-progression-label">Role progression</p>
        <ol class="progression-pair__list mt-5" aria-labelledby="role-progression-label">
          {roleArc.map((stage, index) => (
            <li class="progression-pair__item" style={`--prog-i: ${index}`}>
              <span class="eyebrow w-6 shrink-0" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="font-serif text-lg text-ink sm:text-xl">{stage}</span>
            </li>
          ))}
        </ol>
        <p class="progression-pair__note mt-4 text-sm text-muted">
          {roleArc.join(' → ')}
        </p>
      </div>
      <div>
        <p class="eyebrow" id="scope-progression-label">Scope progression</p>
        <ol class="progression-pair__list mt-5" aria-labelledby="scope-progression-label">
          {scopeArc.map((stage, index) => (
            <li class="progression-pair__item" style={`--prog-i: ${index}`}>
              <span class="eyebrow w-6 shrink-0" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="font-serif text-lg text-ink sm:text-xl">{stage}</span>
            </li>
          ))}
        </ol>
        <p class="progression-pair__note mt-4 text-sm text-muted">
          {scopeArc.join(' → ')}
        </p>
      </div>
    </div>
  )
}
