---
interface Props {
  title: string;
  subtitle?: string;
  description: string;
  href: string;
  domains?: string[];
  architectureType?: string;
  draft?: boolean;
  architectureId?: string;
}

const {
  title,
  subtitle,
  description,
  href,
  domains = [],
  architectureType,
  draft = false,
  architectureId,
} = Astro.props;

const domainLine = domains.slice(0, 3).join(' · ');
---

<article class="spec-entry">
  <a class="spec-entry__link" href={href}>
    <div class="spec-entry__meta">
      {architectureId && <span class="spec-entry__id">{architectureId}</span>}
      {architectureType && <span class="eyebrow">{architectureType}</span>}
      {
        draft && (
          <span class="perspective-draft-badge" role="status">
            Draft
          </span>
        )
      }
    </div>
    <h3 class="spec-entry__title">{title}</h3>
    {subtitle && <p class="spec-entry__subtitle">{subtitle}</p>}
    <p class="spec-entry__summary">{description}</p>
    {domainLine && <p class="spec-entry__domains">{domainLine}</p>}
  </a>
</article>
