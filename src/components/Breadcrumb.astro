---
import { withBase } from '../utils/urls';

interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="site-shell pt-8">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && <span aria-hidden="true">/</span>}
          {index === items.length - 1 ? (
            <span aria-current="page" class="text-ink">
              {item.label}
            </span>
          ) : (
            <a href={withBase(item.href)} class="no-underline hover:underline">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
