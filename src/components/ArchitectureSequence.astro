---
/**
 * Editorial architecture sequence model for Practice (and reusable later).
 * Non-interactive; stages carry text equivalents — direction is not colour-only.
 */
import type { ArchitectureSequenceModel } from '../data/architecture-practice-models';

interface Props {
  model: ArchitectureSequenceModel;
}

const { model } = Astro.props;
const headingId = `${model.id}-heading`;
---

<section
  class="arch-sequence section-space"
  id={model.id}
  aria-labelledby={headingId}
  data-reveal
>
  <div class="site-shell">
    <div class="section-header max-w-3xl">
      <p class="eyebrow">{model.eyebrow}</p>
      <h2 id={headingId} class="mt-3 text-3xl sm:text-4xl">{model.title}</h2>
      <p class="mt-4 max-w-2xl text-muted">{model.intro}</p>
    </div>

    <p class="arch-sequence__progression mt-8" aria-hidden="true">
      {model.stages.map((stage) => stage.title).join(' → ')}
    </p>

    <ol class="arch-sequence__list mt-6" aria-label={model.sequenceLabel}>
      {
        model.stages.map((stage, index) => (
          <li class="arch-sequence__item" id={`${model.id}-${stage.id}`}>
            <p class="arch-sequence__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </p>
            <div class="arch-sequence__body">
              <h3 class="arch-sequence__title">{stage.title}</h3>
              <p class="arch-sequence__text">{stage.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    {
      model.feedback && (
        <p class="arch-sequence__feedback" role="note">
          <span class="arch-sequence__feedback-marker" aria-hidden="true">↻</span>
          <span>
            <span class="arch-sequence__feedback-cue">{model.feedback.cue}</span>{' '}
            {model.feedback.text}
          </span>
        </p>
      )
    }
  </div>
</section>
