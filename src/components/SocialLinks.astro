---
import { getEnabledSocialLinks } from '../data/social';

const enabled = getEnabledSocialLinks();
---

{
  enabled.length > 0 ? (
    <ul class="flex flex-wrap gap-3">
      {enabled.map((link) => (
        <li>
          <a class="btn-secondary" href={link.href!} rel="noopener noreferrer">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  ) : null
}
