---
import {
  enterpriseArchitecturePractice,
  supportingSpecialisms,
} from '../data/capabilities';
import { withBase } from '../utils/urls';

const bidat = enterpriseArchitecturePractice.bidatDomains ?? [];
---

<section class="section-space" aria-labelledby="practice-preview-heading" data-reveal>
  <div class="site-shell">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="section-header">
        <p class="eyebrow">Centrepiece</p>
        <h2 id="practice-preview-heading" class="mt-3 text-3xl sm:text-4xl">
          Architecture Practice
        </h2>
        <p class="mt-4 max-w-2xl text-muted">
          Enterprise Architecture is the parent discipline. Within EA, Business Architecture
          establishes business direction before technology architecture decisions — supported by
          platform, cloud, integration, identity &amp; security, and emerging technology depth.
        </p>
      </div>
      <a class="btn-secondary shrink-0 btn-with-arrow" href={withBase('/architecture/practice')}>
        View Architecture Practice
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="practice-preview-ea mt-12">
      <a
        class="practice-preview-ea__link"
        href={withBase('/architecture/practice#enterprise-architecture')}
      >
        <span class="practice-preview__marker" aria-hidden="true">01</span>
        <span class="practice-preview__title">{enterpriseArchitecturePractice.title}</span>
        <span class="practice-preview__summary">{enterpriseArchitecturePractice.summary}</span>
      </a>
      <ul class="practice-preview-bidat" aria-label="BIDAT domains within Enterprise Architecture">
        {
          bidat.map((domain) => (
            <li>
              <a href={withBase(`/architecture/practice#${domain.id}`)}>{domain.title}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="practice-preview mt-8" aria-label="Supporting architecture specialisms">
      {
        supportingSpecialisms.map((domain, index) => (
          <li class="practice-preview__item" style={`--item-i: ${index}`}>
            <a
              class="practice-preview__link"
              href={withBase(`/architecture/practice#${domain.id}`)}
            >
              <span class="practice-preview__marker" aria-hidden="true">
                {String(index + 2).padStart(2, '0')}
              </span>
              <span class="practice-preview__title">{domain.title}</span>
              <span class="practice-preview__summary">{domain.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
