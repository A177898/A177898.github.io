---
import { architectureApproach } from '../data/profile';
---

<section class="section-band section-band--contrast" aria-labelledby="approach-heading">
  <div class="site-shell">
    <div class="section-header">
      <p class="eyebrow">Approach</p>
      <h2 id="approach-heading" class="mt-3 text-3xl sm:text-4xl">How I Architect</h2>
      <p class="mt-4 max-w-2xl text-muted">
        A repeatable way of working — from business capability to governed evolution.
      </p>
    </div>

    <ol class="approach-list mt-12">
      {
        architectureApproach.map((item) => (
          <li class="approach-list__item">
            <p class="approach-list__step">{item.step}</p>
            <div class="approach-list__body">
              <h3 class="approach-list__title">{item.title}</h3>
              <p class="approach-list__text">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
