---
interface Props {
  label: string;
  href?: string;
}

const { label, href } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class="inline-flex rounded-sm border border-border bg-accent-soft px-2.5 py-1 text-xs font-medium text-ink no-underline"
    >
      {label}
    </a>
  ) : (
    <span class="inline-flex rounded-sm border border-border bg-accent-soft px-2.5 py-1 text-xs font-medium text-ink">
      {label}
    </span>
  )
}
