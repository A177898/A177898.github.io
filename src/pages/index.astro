---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ArchitectureModel from '../components/ArchitectureModel.astro';
import PracticePreview from '../components/PracticePreview.astro';
import HowIArchitect from '../components/HowIArchitect.astro';
import RevealInit from '../components/RevealInit.astro';
import { profile } from '../data/profile';
import { pageTitle, siteMeta } from '../data/seo';
import { getCollection } from 'astro:content';
import { isVisibleForReview } from '../utils/publication';
import { withBase } from '../utils/urls';

const allowDrafts = import.meta.env.DEV && !import.meta.env.PROD;
const hasExperience = (await getCollection('experience')).some((entry) =>
  isVisibleForReview(entry.data, { allowDrafts }),
);
---

<PageLayout title={pageTitle()} description={siteMeta.defaultDescription}>
  <Hero
    eyebrow={profile.headline}
    title={profile.fullName}
    subtitle={`“${profile.proposition}”`}
    lead={profile.propositionSupport}
    split
  >
    <Fragment slot="actions">
      <a class="btn-primary btn-with-arrow" href={withBase('/architecture/practice')}>
        Explore Architecture Practice
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
      {hasExperience ? (
        <a class="btn-text" href={withBase('/experience')}>Experience</a>
      ) : (
        <a class="btn-text" href={withBase('/about')}>About</a>
      )}
      <a class="btn-text" href={withBase('/resume')}>Resume</a>
    </Fragment>
    <ArchitectureModel slot="model" variant="hero" />
  </Hero>

  <PracticePreview />

  <HowIArchitect />

  <RevealInit />
</PageLayout>
