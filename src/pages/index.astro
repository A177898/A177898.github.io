---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ArchitectureLifecycle from '../components/ArchitectureLifecycle.astro';
import HowIArchitect from '../components/HowIArchitect.astro';
import { profile } from '../data/profile';
import { pageTitle, siteMeta } from '../data/seo';
import { getCollection } from 'astro:content';
import { isVisibleForReview } from '../utils/publication';
import { withBase } from '../utils/urls';

const allowDrafts = import.meta.env.DEV && !import.meta.env.PROD;
const hasExperience = (await getCollection('experience')).some((entry) =>
  isVisibleForReview(entry.data, { allowDrafts }),
);
---

<PageLayout title={pageTitle()} description={siteMeta.defaultDescription}>
  <Hero
    eyebrow={profile.headline}
    title={profile.fullName}
    subtitle={`“${profile.proposition}”`}
    lead={profile.propositionSupport}
  >
    <Fragment slot="actions">
      <a class="btn-primary" href={withBase('/architecture/practice')}>Explore Architecture Practice</a>
      {hasExperience ? (
        <a class="btn-text" href={withBase('/experience')}>Experience</a>
      ) : (
        <a class="btn-text" href={withBase('/about')}>About</a>
      )}
      <a class="btn-text" href={withBase('/resume')}>Resume</a>
    </Fragment>
  </Hero>

  <ArchitectureLifecycle />

  <section class="section-space" aria-labelledby="practice-preview-heading">
    <div class="site-shell">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div class="section-header">
          <p class="eyebrow">Centrepiece</p>
          <h2 id="practice-preview-heading" class="mt-3 text-3xl sm:text-4xl">
            Architecture Practice
          </h2>
          <p class="mt-4 max-w-2xl text-muted">
            Breadth across enterprise, platform, cloud, integration, identity &amp; security, and
            emerging technology — framed as decision-making, not a technology catalogue.
          </p>
        </div>
        <a class="btn-secondary shrink-0" href={withBase('/architecture/practice')}>
          View Architecture Practice
        </a>
      </div>
    </div>
  </section>

  <HowIArchitect />
</PageLayout>
