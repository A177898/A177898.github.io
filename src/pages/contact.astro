---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { profile } from '../data/profile';
import { pageTitle } from '../data/seo';
import { getEnabledSocialLinks, socialLinks } from '../data/social';

const enabled = getEnabledSocialLinks();
const pendingChannels = socialLinks.filter(
  (link) =>
    (link.id === 'linkedin' || link.id === 'github') &&
    (!link.enabled || !link.href),
);
---

<PageLayout
  title={pageTitle('Contact')}
  description={`Contact ${profile.fullName}, Enterprise Architect.`}
>
  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Contact', href: '/contact' },
    ]}
  />

  <section class="section-space">
    <div class="site-shell max-w-2xl">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Connect</h1>
      <p class="mt-4 text-lg text-muted">{profile.fullName} · {profile.headline}</p>
      <p class="mt-6 max-w-xl text-muted">
        I'm open to conversations about enterprise architecture, technology strategy, platform
        architecture and technology transformation.
      </p>

      {
        enabled.length > 0 ? (
          <div class="mt-10">
            <SocialLinks />
          </div>
        ) : (
          <p class="mt-10 text-sm text-muted" role="status">
            Professional profile links will appear here once LinkedIn and GitHub URLs are configured
            for publication.
            {pendingChannels.length > 0 && (
              <>
                {' '}
                Pending: {pendingChannels.map((link) => link.label).join(', ')}.
              </>
            )}
          </p>
        )
      }
    </div>
  </section>
</PageLayout>
