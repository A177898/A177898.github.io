---
/**
 * Resume — executive printable overview.
 * Production uses only publishable experience. DEV may show drafts with indicators.
 * Does not invent education, certifications, achievements or contact channels.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { profile } from '../data/profile';
import { pageTitle } from '../data/seo';
import { getCollection } from 'astro:content';
import { isVisibleForReview } from '../utils/publication';
import { formatExperiencePeriod, isEarlierCareer } from '../utils/experience';
import { getEnabledSocialLinks } from '../data/social';
import { withBase } from '../utils/urls';

const isProduction = import.meta.env.PROD;
const allowDrafts = import.meta.env.DEV && !isProduction;
const showDraftIndicators = allowDrafts;

const experience = (await getCollection('experience'))
  .filter((entry) => isVisibleForReview(entry.data, { allowDrafts }))
  .sort((a, b) => a.data.order - b.data.order);

const professional = experience.filter((entry) => !isEarlierCareer(entry.data.density));
const earlier = experience.filter((entry) => isEarlierCareer(entry.data.density));

const leadershipAreas = [
  'Business Architecture',
  'Enterprise Architecture',
  'Technology Strategy',
  'Platform Architecture',
  'Cloud Architecture',
  'Integration Architecture',
  'Identity & Security',
  'AI & Emerging Technology',
  'Architecture Governance',
] as const;

/** Education / certifications: no supported data in repository — sections omitted. */
const education: { title: string; detail: string }[] = [];
const certifications: { title: string; detail: string }[] = [];

const social = getEnabledSocialLinks();
const portfolioLinks = [
  { label: 'Portfolio', href: withBase('/') },
  { label: 'Architecture Practice', href: withBase('/architecture/practice') },
  ...social.map((link) => ({ label: link.label, href: link.href! })),
];

const draftCount = showDraftIndicators
  ? experience.filter((entry) => entry.data.status === 'draft').length
  : 0;
---

<PageLayout
  title={pageTitle('Resume')}
  description={`Resume for ${profile.fullName}, Enterprise Architect — connecting business strategy, people, process and technology.`}
>
  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Resume', href: '/resume' },
    ]}
  />

  <section class="section-space resume-doc">
    <div class="site-shell max-w-3xl">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow no-print">Resume</p>
          <h1 class="mt-3 text-4xl sm:text-5xl">{profile.fullName}</h1>
          <p class="mt-3 text-xl text-muted">{profile.headline}</p>
        </div>
        <div class="flex flex-wrap gap-3 no-print">
          <button type="button" class="btn-secondary" onclick="window.print()">
            Print / Save as PDF
          </button>
        </div>
      </div>

      {
        showDraftIndicators && draftCount > 0 && (
          <aside
            class="mt-8 border border-border bg-band px-4 py-3 text-sm text-muted no-print"
            role="status"
          >
            Draft review mode: {draftCount} experience
            {draftCount === 1 ? ' entry is' : ' entries are'} unpublished. Production Resume uses only
            publishable experience.
          </aside>
        )
      }

      <section class="resume-section mt-12" aria-labelledby="executive-profile-heading">
        <h2 id="executive-profile-heading" class="text-2xl">Executive Profile</h2>
        <p class="mt-3 text-muted">{profile.proposition}</p>
        <p class="mt-3 text-muted">{profile.propositionSupport}</p>
        <p class="mt-4 text-sm text-muted">{profile.careerArc.join(' → ')}</p>
      </section>

      <section class="resume-section mt-10" aria-labelledby="leadership-heading">
        <h2 id="leadership-heading" class="text-2xl">Architecture &amp; Technology Leadership</h2>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {
            leadershipAreas.map((area) => (
              <li class="text-sm text-ink">
                <span class="font-medium">{area}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        professional.length > 0 ? (
          <section class="resume-section mt-10" aria-labelledby="professional-experience-heading">
            <h2 id="professional-experience-heading" class="text-2xl">Professional Experience</h2>
            <ul class="resume-experience mt-5 space-y-6">
              {professional.map((entry) => {
                const pending = entry.data.pendingAppointment === true;
                const periodLabel = formatExperiencePeriod(entry.data.period, {
                  pendingAppointment: pending,
                });
                const summary = entry.data.summary
                  .split(/\n\s*\n/)
                  .map((part) => part.replace(/\s+/g, ' ').trim())
                  .filter(Boolean)[0];
                return (
                  <li>
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <p class="font-semibold text-ink">{entry.data.role}</p>
                      {showDraftIndicators && entry.data.status === 'draft' && (
                        <span class="experience-timeline__draft no-print">Draft</span>
                      )}
                      {showDraftIndicators && pending && (
                        <span class="experience-timeline__draft no-print" role="status">
                          Pending effective date
                        </span>
                      )}
                    </div>
                    <p class="text-sm text-muted">
                      {entry.data.organisation}
                      <span aria-hidden="true"> · </span>
                      {periodLabel}
                    </p>
                    {summary && <p class="mt-2 text-sm text-muted">{summary}</p>}
                  </li>
                );
              })}
            </ul>
          </section>
        ) : (
          !showDraftIndicators && (
            <section class="resume-section mt-10" aria-labelledby="professional-experience-heading">
              <h2 id="professional-experience-heading" class="text-2xl">Professional Experience</h2>
              <p class="mt-3 text-sm text-muted">
                Professional experience will appear here once entries are approved for publication.
              </p>
            </section>
          )
        )
      }

      {
        earlier.length > 0 && (
          <section class="resume-section mt-10" aria-labelledby="earlier-career-heading">
            <h2 id="earlier-career-heading" class="text-2xl">Earlier Career</h2>
            <ul class="resume-experience mt-5 space-y-4">
              {earlier.map((entry) => {
                const periodLabel = formatExperiencePeriod(entry.data.period, {
                  pendingAppointment: entry.data.pendingAppointment === true,
                });
                return (
                  <li>
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <p class="font-semibold text-ink">{entry.data.role}</p>
                      {showDraftIndicators && entry.data.status === 'draft' && (
                        <span class="experience-timeline__draft no-print">Draft</span>
                      )}
                    </div>
                    <p class="text-sm text-muted">
                      {entry.data.organisation}
                      <span aria-hidden="true"> · </span>
                      {periodLabel}
                    </p>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        education.length > 0 && (
          <section class="resume-section mt-10" aria-labelledby="education-heading">
            <h2 id="education-heading" class="text-2xl">Education</h2>
            <ul class="mt-4 space-y-3">
              {education.map((item) => (
                <li>
                  <p class="font-semibold text-ink">{item.title}</p>
                  <p class="text-sm text-muted">{item.detail}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        certifications.length > 0 && (
          <section class="resume-section mt-10" aria-labelledby="certifications-heading">
            <h2 id="certifications-heading" class="text-2xl">
              Certifications / Professional Development
            </h2>
            <ul class="mt-4 space-y-3">
              {certifications.map((item) => (
                <li>
                  <p class="font-semibold text-ink">{item.title}</p>
                  <p class="text-sm text-muted">{item.detail}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="resume-section mt-10" aria-labelledby="portfolio-links-heading">
        <h2 id="portfolio-links-heading" class="text-2xl">
          Architecture Portfolio / Professional Links
        </h2>
        <ul class="mt-4 space-y-2">
          {
            portfolioLinks.map((link) => (
              <li class="text-sm">
                <a class="font-medium text-ink underline decoration-border underline-offset-2" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>
</PageLayout>
