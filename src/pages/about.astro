---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { profile } from '../data/profile';
import { pageTitle } from '../data/seo';
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/publication';

const leadership = (await getCollection('leadership')).filter((entry) => isPublished(entry.data));
---

<PageLayout
  title={pageTitle('About')}
  description={`About ${profile.fullName}, Enterprise Architect — career progression from software engineering to enterprise architecture.`}
>
  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about' },
    ]}
  />

  <section class="section-space">
    <div class="site-shell max-w-3xl">
      <p class="eyebrow">Profile</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{profile.fullName}</h1>
      <p class="mt-4 text-xl text-muted">{profile.headline}</p>
      <p class="mt-6 font-serif text-2xl leading-snug text-ink">
        “{profile.proposition}”
      </p>

      <div class="prose-portfolio mt-10 space-y-4 text-muted">
        {profile.aboutSummary.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <h2 class="mt-16 text-3xl">Career progression</h2>
      <p class="mt-4 text-muted">
        Professional path and expanding architectural scope — from building systems to shaping
        enterprise technology direction.
      </p>

      <div class="progression-pair">
        <div>
          <p class="eyebrow">Role progression</p>
          <ol class="progression-pair__list mt-5">
            {
              profile.careerArc.map((stage, index) => (
                <li class="progression-pair__item">
                  <span class="eyebrow w-6 shrink-0">{String(index + 1).padStart(2, '0')}</span>
                  <span class="font-serif text-lg text-ink sm:text-xl">{stage}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div>
          <p class="eyebrow">Scope</p>
          <ol class="progression-pair__list mt-5">
            {
              profile.scopeArc.map((stage, index) => (
                <li class="progression-pair__item">
                  <span class="eyebrow w-6 shrink-0">{String(index + 1).padStart(2, '0')}</span>
                  <span class="font-serif text-lg text-ink sm:text-xl">{stage}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      {
        leadership.length > 0 && (
          <>
            <h2 class="mt-16 text-3xl">Leadership & contributions</h2>
            <ul class="mt-6 space-y-4">
              {leadership.map((item) => (
                <li class="card-quiet">
                  <h3 class="text-xl">{item.data.title}</h3>
                  <p class="mt-2 text-sm text-muted">{item.data.description}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>
</PageLayout>
