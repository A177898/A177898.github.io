---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CareerProgression from '../components/CareerProgression.astro';
import RevealInit from '../components/RevealInit.astro';
import { profile } from '../data/profile';
import { pageTitle } from '../data/seo';
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/publication';
import { withBase } from '../utils/urls';

const leadership = (await getCollection('leadership')).filter((entry) => isPublished(entry.data));
---

<PageLayout
  title={pageTitle('About')}
  description={`About ${profile.fullName}, Enterprise Architect — career progression from software engineering to enterprise architecture.`}
>
  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about' },
    ]}
  />

  <section class="section-space">
    <div class="site-shell max-w-3xl">
      <p class="eyebrow">Profile</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{profile.fullName}</h1>
      <p class="mt-4 text-xl text-muted">{profile.headline}</p>
      <p class="mt-6 font-serif text-2xl leading-snug text-ink">
        “{profile.proposition}”
      </p>

      <p class="about-opening mt-10 text-lg leading-relaxed text-muted" data-reveal>
        {profile.aboutOpening}
      </p>

      <h2 class="mt-16 text-3xl" id="career-story">Career story</h2>
      <p class="mt-4 max-w-2xl text-muted">
        How engineering experience broadened into architectural judgement — synthesised from the
        career path detailed on{' '}
        <a href={withBase('/experience')}>Experience</a>.
      </p>

      <ol class="about-story mt-10" aria-labelledby="career-story" data-reveal>
        {
          profile.aboutStory.map((stage, index) => (
            <li class="about-story__item">
              <p class="about-story__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </p>
              <div class="about-story__body">
                <h3 class="about-story__title">{stage.title}</h3>
                <p class="about-story__text">{stage.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <h2 class="mt-16 text-3xl" id="career-progression">Career progression</h2>
      <p class="mt-4 max-w-2xl text-muted">
        The same journey expressed as role and scope — from building systems to shaping enterprise
        technology direction.
      </p>

      <CareerProgression variant="pair" />

      <p class="about-closing mt-12 max-w-2xl font-serif text-xl leading-snug text-ink" data-reveal>
        {profile.aboutClosing}
      </p>
      <p class="mt-6 text-muted">
        For the factual chronology, see{' '}
        <a href={withBase('/experience')}>Experience</a>
        . For the architecture model that this progression informs, see the{' '}
        <a href={withBase('/#ea-approach')}>homepage approach</a>
        {' '}and{' '}
        <a href={withBase('/architecture/practice')}>Architecture Practice</a>.
      </p>

      {
        leadership.length > 0 && (
          <>
            <h2 class="mt-16 text-3xl">Leadership & contributions</h2>
            <ul class="mt-6 space-y-4">
              {leadership.map((item) => (
                <li class="card-quiet">
                  <h3 class="text-xl">{item.data.title}</h3>
                  <p class="mt-2 text-sm text-muted">{item.data.description}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>
  <RevealInit />
</PageLayout>
