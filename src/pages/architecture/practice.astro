---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CapabilityCard from '../../components/CapabilityCard.astro';
import RevealInit from '../../components/RevealInit.astro';
import { capabilityDomains } from '../../data/capabilities';
import { pageTitle } from '../../data/seo';
---

<PageLayout
  title={pageTitle('Architecture Practice')}
  description="Architecture Practice capability model — enterprise, platform, cloud, integration, identity & security, and AI."
>
  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Architecture', href: '/architecture' },
      { label: 'Practice', href: '/architecture/practice' },
    ]}
  />

  <section class="section-space">
    <div class="site-shell">
      <p class="eyebrow">Centrepiece</p>
      <h1 class="mt-3 max-w-3xl text-4xl sm:text-5xl">Architecture Practice</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Capability domains framed around principles and architectural decision-making — not a
        catalogue of projects or a technology glossary. Practice connects onward to Perspectives and
        Reference Architectures where those materials are available.
      </p>

      <div class="capability-grid mt-14">
        {
          capabilityDomains.map((domain, index) => (
            <CapabilityCard domain={domain} index={index} />
          ))
        }
      </div>
    </div>
  </section>
  <RevealInit />
</PageLayout>
