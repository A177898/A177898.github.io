---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EnterpriseArchitectureApproach from '../../components/EnterpriseArchitectureApproach.astro';
import CapabilityCard from '../../components/CapabilityCard.astro';
import RevealInit from '../../components/RevealInit.astro';
import { capabilityDomains } from '../../data/capabilities';
import { profile } from '../../data/profile';
import { pageTitle } from '../../data/seo';
---

<PageLayout
  title={pageTitle('Architecture Practice')}
  description="Architecture Practice — business architecture as the foundation, supported by enterprise, platform, cloud, integration, identity & security, and emerging technology."
>
  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Architecture', href: '/architecture' },
      { label: 'Practice', href: '/architecture/practice' },
    ]}
  />

  <section class="section-space">
    <div class="site-shell">
      <p class="eyebrow">Centrepiece</p>
      <h1 class="mt-3 max-w-3xl text-4xl sm:text-5xl">Architecture Practice</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Business architecture leads the offering. Technology and platform depth support broader
        enterprise outcomes — framed as decision-making, not a technology catalogue.
      </p>
      <p class="mt-4 max-w-2xl text-muted">
        “{profile.proposition}”
      </p>
    </div>
  </section>

  <EnterpriseArchitectureApproach variant="full" id="ea-approach" />

  <section class="section-space" aria-labelledby="capability-domains-heading">
    <div class="site-shell">
      <div class="section-header">
        <p class="eyebrow">Capability domains</p>
        <h2 id="capability-domains-heading" class="mt-3 text-3xl sm:text-4xl">
          From business architecture to technology depth
        </h2>
        <p class="mt-4 max-w-2xl text-muted">
          Business architecture establishes the foundation. Enterprise architecture connects that
          foundation to coordinated change. Platform, cloud, integration, identity &amp; security,
          and emerging technology remain areas of supporting depth.
        </p>
      </div>

      <div class="capability-grid mt-14">
        {
          capabilityDomains.map((domain, index) => (
            <CapabilityCard domain={domain} index={index} />
          ))
        }
      </div>
    </div>
  </section>
  <RevealInit />
</PageLayout>
