---
import PageLayout from '../../../layouts/PageLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ArchitectureCard from '../../../components/ArchitectureCard.astro';
import ResearchDisclaimer from '../../../components/ResearchDisclaimer.astro';
import { pageTitle } from '../../../data/seo';
import { getCollection } from 'astro:content';
import { isVisibleForReview } from '../../../utils/publication';
import { withBase } from '../../../utils/urls';

const isProduction = import.meta.env.PROD;
const allowDrafts = import.meta.env.DEV && !isProduction;
const showDraftIndicators = allowDrafts;

const architectures = (await getCollection('architectures'))
  .filter((entry) => isVisibleForReview(entry.data, { allowDrafts }))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const draftCount = showDraftIndicators
  ? architectures.filter((entry) => entry.data.status === 'draft').length
  : 0;

if (import.meta.env.PROD && architectures.length === 0) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<PageLayout
  title={pageTitle('Reference Architectures')}
  description="Independently authored, vendor-neutral reference architectures."
>
  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Architecture', href: '/architecture' },
      { label: 'Reference', href: '/architecture/reference' },
    ]}
  />

  <section class="section-space">
    <div class="site-shell">
      <p class="eyebrow">Architecture</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Reference Architectures</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Where principles become structured models — boundaries, responsibilities, decisions and
        trade-offs, independently developed for professional knowledge sharing.
      </p>
      <div class="mt-6 max-w-2xl">
        <ResearchDisclaimer compact />
      </div>

      {
        !isProduction && draftCount > 0 && (
          <aside
            class="mt-8 max-w-2xl border border-border bg-band px-4 py-3 text-sm text-muted"
            role="status"
          >
            Draft review mode: {draftCount} reference architecture
            {draftCount === 1 ? ' is' : 's are'} unpublished. Drafts are not included in production
            builds until explicitly approved for publication.
          </aside>
        )
      }

      {
        architectures.length === 0 ? (
          <p class="mt-10 text-sm text-muted">No reference architectures are published yet.</p>
        ) : (
          <div class="mt-12 grid gap-6 md:grid-cols-2">
            {architectures.map((entry) => (
              <ArchitectureCard
                title={entry.data.title}
                subtitle={entry.data.subtitle}
                description={entry.data.description}
                href={withBase(`/architecture/reference/${entry.id}`)}
                domains={entry.data.domains}
                architectureType={entry.data.architectureType}
                draft={showDraftIndicators && entry.data.status === 'draft'}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</PageLayout>
